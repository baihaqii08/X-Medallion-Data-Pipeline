# X authentication cookies. Keep the completed .env file private.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# Browser and extraction controls
TWITTER_HEADLESS=false
TWITTER_BROWSER_CHANNEL=
TWITTER_MAX_TRENDS=30
TWITTER_SCROLLS_PER_TREND=15

# Content validation: observe, balanced, or strict
CONTENT_FILTER_MODE=balanced

# Beanstalkd
BEANSTALKD_HOST=127.0.0.1
BEANSTALKD_PORT=11300
BEANSTALKD_TUBE=raw-data

# MinIO / S3-compatible storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_NAME=narrative-datalake
S3_AUTO_CREATE_BUCKET=true

# Event partitions and scheduler use this business timezone
DATA_TIMEZONE=Asia/Jakarta
PIPELINE_TIMEZONE=Asia/Jakarta
PIPELINE_SCHEDULE=09:30,11:00,12:30,14:00,15:30,16:50
GOLD_SCHEDULE=23:55
SCHEDULER_POLL_SECONDS=20
WORKER_RETRY_DELAY_SECONDS=5
