# ==============================================================
# SECRETS TEMPLATE (.env.example)
# ==============================================================
# Petunjuk: 
# 1. Salin file ini dan ubah namanya menjadi `.env`
# 2. Isi nilai-nilai di bawah ini dengan kredensial asli Anda.

# Twitter Cookies (Auth)
TWITTER_AUTH_TOKEN=your_auth_token_here
TWITTER_CT0=your_ct0_token_here

# MinIO / S3 Data Lake Configuration
S3_ENDPOINT=https://your-ngrok-url.ngrok-free.dev
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=narative-datalake
